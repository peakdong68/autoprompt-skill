{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ap_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scope-convergence-guard.cjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scope-convergence-guard.cjs\""
          }
        ]
      }
    ]
  }
}
